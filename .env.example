# PeerUP Environment Variables Configuration

# Server Port
PORT=5001

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Credentials (Test or Production)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Mux Video Infrastructure Credentials
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_SIGNING_KEY=your_mux_signing_key
MUX_SIGNING_SECRET=your_mux_signing_secret

# Platform Configuration
PLATFORM_COMMISSION_PERCENT=25
MIN_PAYOUT_THRESHOLD_INR=250
